generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @default("Admin")
  password  String
  role      String   @default("admin")
  createdAt DateTime @default(now())
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String?
  password     String?
  avatarUrl    String?  @db.LongText
  googleId     String?  @unique
  role         String   @default("Customer")
  status       String   @default("Active")
  joinDate     String?
  bookingCount Int      @default(0)
  createdAt    DateTime @default(now())
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String?
  name         String
  phone        String?
  googleId     String?   @unique
  avatarUrl    String?   @db.Text
  authProvider String    @default("local")
  createdAt    DateTime  @default(now())
  bookings     Booking[]
}

model Movie {
  id          String      @id @default(uuid())
  title       String
  description String?     @db.Text
  genre       String?
  posterUrl   String?     @db.Text
  showtimes   Showtime[]
}

model Showtime {
  id       String    @id @default(uuid())
  movieId  String
  movie    Movie     @relation(fields: [movieId], references: [id])
  startTime DateTime
  hall     String
  bookings Booking[]
}

model Seat {
  id          String  @id @default(uuid())
  row         String
  number      Int
  isAvailable Boolean @default(true)
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id])
}

model Booking {
  id         String     @id @default(uuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  showtimeId String
  showtime   Showtime   @relation(fields: [showtimeId], references: [id])
  seats      Seat[]
  total      Float
  createdAt  DateTime   @default(now())
}

model Offer {
  id          String   @id @default(cuid())
  title       String
  caption     String?
  badge       String?  @default("SPECIAL OFFER")
  tag         String?  @default("EXCLUSIVE")
  image       String   @db.LongText
  icon        String?  @default("🍿")
  validity    String?  @default("Limited Time")
  description String   @db.Text
  bullets     String?  @db.Text
  publishDate String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}

model Slide {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  description String   @db.Text
  image       String   @db.LongText
  badges      String?  @db.Text
  linkUrl     String?  @default("/movies")
  status      String   @default("Active")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}
